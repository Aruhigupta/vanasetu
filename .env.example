# Global Environment Configuration - HerbChain AI

PROJECT_NAME="HerbChain AI"
ENVIRONMENT=development

# Database Settings (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./herbchain.db
# DATABASE_URL=postgresql://herbchain_user:herbchain_password@localhost:5432/herbchain_db

# JWT & Security Secrets
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Blockchain Settings (Polygon Amoy Testnet)
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002
CONTRACT_ADDRESS=0x3A9F56cB34720970C48483B462b48e3E43B33072
BLOCKCHAIN_PRIVATE_KEY=your_blockchain_private_key_here

# IPFS & Pinata Storage Configuration
IPFS_GATEWAY=https://ipfs.io/ipfs/
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here
PINATA_JWT=your_pinata_jwt_here

# Frontend Application & API URLs
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed Configuration
SEED_DEMO_DATA=true
